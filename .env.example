###############################################################################
# Express Backend Boilerplate API
# Copy this file to .env and replace all production secrets before deploy.
###############################################################################

# ---------------------------------------------------------------------------
# App runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=express-backend-boilerplate-api
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=0

# Comma-separated browser origins allowed by CORS.
# Production must be explicit, for example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
# Local Node.js default. Docker Compose overrides hostnames to mysql/redis.
DATABASE_URL=mysql://app:secret@localhost:3306/express_backend
DB_POOL_CONNECTION_LIMIT=10
DB_POOL_MAX_IDLE=10
DB_POOL_IDLE_TIMEOUT_MS=60000
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# JWT and auth token policy
# ---------------------------------------------------------------------------
# Production guard rejects the default change-me values below.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ISSUER=express-backend-boilerplate-api
JWT_AUDIENCE=express-backend-boilerplate-api-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# One-time code used after Google OAuth callback before issuing JWT tokens.
AUTH_CODE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
# Production must use redis. Memory is only for local development/tests.
RATE_LIMIT_STORE=memory
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OAUTH_WINDOW_MS=900000
RATE_LIMIT_OAUTH_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=30

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# Register GOOGLE_CALLBACK_URL in Google Cloud Console OAuth credentials.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Frontend receives ?code=... on success, then calls /api/v1/auth/google/exchange.
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/auth/callback
FRONTEND_AUTH_ERROR_URL=http://localhost:5173/login

# ---------------------------------------------------------------------------
# Mail / SMTP
# ---------------------------------------------------------------------------
# Local development works well with Mailpit/MailHog on localhost:1025.
# MAIL_USER and MAIL_PASSWORD must be filled together or both left empty.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Express API <no-reply@example.com>

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# UPLOAD_ALLOWED_MIME_TYPES is comma-separated.
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_MB=5
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
